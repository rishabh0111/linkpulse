# Non-secret runtime configuration, rendered into a ConfigMap by the configMapGenerator in
# kustomization.yaml.
#
# Every key here is an environment variable read by internal/config, and the names match
# what docker-compose.yml sets for the same image. That is deliberate: the compose inner
# loop and the cluster path must not be able to drift into different behaviour, or the
# fast loop stops predicting what the deployment actually does.
#
# What is NOT here: DDB_ENDPOINT. Empty means real AWS (internal/config treats it that
# way), so the base is the AWS shape and the local overlay is the one that has to say
# something extra. The alternative -- a LocalStack endpoint in the base that the AWS path
# has to unset -- makes production correctness depend on an override being remembered.

DDB_TABLE=linkpulse
AWS_REGION=ap-south-1

# 16 shards spread the click aggregate across 16 partition keys: the mitigation from
# docs/data-model.md. Chaos experiment 1 flips this to 1 against the identical image to
# reproduce the hot partition. Because it lives in a generated ConfigMap whose name
# carries a content hash, that flip is a one-line commit that actually rolls the pods --
# see the note in kustomization.yaml about why a static ConfigMap would not.
CLICK_SHARDS=16

CLICK_TTL_DAYS=30
CLICK_QUEUE_SIZE=2048
CLICK_WORKERS=8

# Must be shorter than terminationGracePeriodSeconds minus the preStop sleep, or the
# kubelet SIGKILLs the process partway through draining the click queue -- trading away
# the "clicks queued before shutdown still land" property the unit tests pin, in the one
# environment where it matters. 5s preStop + 15s drain = 20s, against a 40s grace period.
SHUTDOWN_GRACE=15s

READY_CACHE_TTL=2s
PUBLIC_BASE_URL=http://linkpulse.localtest.me:8088
LINKPULSE_VERSION=dev
