    {
      "id": 13,
      "type": "timeseries",
      "title": "Clicks recorded vs dropped",
      "description": "Redirects stay fast under throttling because clicks are written asynchronously -- so this, not latency, is the incident signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(linkpulse_clicks_recorded_total[1m]))",
          "legendFormat": "recorded",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(linkpulse_clicks_dropped_total[1m]))",
          "legendFormat": "dropped: {{reason}}",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "pointSize": 4,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
